<header class="flex space-between">
    <a href="/">File Uploader</a>
    <% if (locals.currentUser) { %>
        <a href="/add-file">Add a file</a>
        <%- include('profileHandler') %>
    <% } else { %>
        <div class="header-options">
            <a href="/log-in" class="button">Login</a>
            <a href="/sign-up" class="button">Sign Up</a>
        </div>
    <% } %>
</header>