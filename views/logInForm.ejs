<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/styles.css">
    <script src="/scripts/index.js" defer></script>
    <title>Login</title>
</head>

<body>
    <%- include('partials/header') %>
    <main>
        <% if (locals.currentUser) { %>
            <h1>You are already logged in. You can log out from the menu if you want to switch accounts</h1>
        <% } else { %>
            <div class="form-card">
                <h1>Welcome back</h1>
                <form action="/log-in" method="POST" class="stack">
                    <div class="input">
                        <label for="username">Username</label>
                        <input id="username" name="username" type="text" />
                        <p class="field-error"><%= loginErrorField === "username" && loginMessage ? loginMessage : " " %></p>
                    </div>
                    <div class="input">
                        <label for="password">Password</label>
                        <input id="password" name="password" type="password" />
                        <p class="field-error"><%= loginErrorField === "password" && loginMessage ? loginMessage : " " %></p>
                    </div>
                    <button type="submit">Login</button>
                </form>
            </div>
        <% } %>
    </main>
</body>

</html>