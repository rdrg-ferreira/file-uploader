<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/styles/styles.css">
    <script src="/scripts/index.js" defer></script>
    <title>Sign Up</title>
</head>

<body>
    <%- include('partials/header') %>
    <main>
        <% if (locals.currentUser) { %>
            <div class="page-card">
                <h1>You are currently logged in. Log out before signing up a new user</h1>
            </div>
        <% } else { %>
            <div class="form-card">
                <h1>Welcome</h1>
                <form action="/sign-up" method="POST" class="stack">
                    <div class="input">
                        <label for="name">Name</label>
                        <input id="name" name="name" type="text" />
                        <p class="field-error"><%= locals.errors && errors.some(e => e.path === "name") ? errors.find(e => e.path === "name").msg : " " %></p>
                    </div>
                    <div class="input">
                        <label for="username">Username</label>
                        <input id="username" name="username" type="text" />
                        <p class="field-error"><%= locals.errors && errors.some(e => e.path === "username") ? errors.find(e => e.path === "username").msg : " " %></p>
                    </div>
                    <div class="input">
                        <label for="password">Password</label>
                        <input id="password" name="password" type="password" />
                        <p class="field-error"><%= locals.errors && errors.some(e => e.path === "password") ? errors.find(e => e.path === "password").msg : " " %></p>
                    </div>
                    <div class="input">
                        <label for="confirmPassword">Confirm password</label>
                        <input id="confirmPassword" name="confirmPassword" type="password" />
                        <p class="field-error"><%= locals.errors && errors.some(e => e.path === "confirmPassword") ? errors.find(e => e.path === "confirmPassword").msg : " " %></p>
                    </div>
                <button type="submit">Sign Up</button>
                </form>
            </div>
        <% } %>
    </main>
</body>

</html>